# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
# Free key: https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Models to try, in order. If one is rate-limited or gone, the next is used.
# Free model IDs change often: run `python scripts/check_llm.py --list-free` and update this line.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free

# Optional tuning (defaults shown)
# RAG_MIN_SCORE=0.45
# RAG_TOP_K=5
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=3
# LLM_MAX_TOKENS=400
